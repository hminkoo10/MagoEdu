# 마고에듀 통합 클라우드 서버 설정 (이 파일을 .env 로 복사해서 고쳐 쓰세요)

# 서버 포트
PORT=8470

# 받을 주소. 같은 서버의 Caddy·nginx 뒤에 둘 때는 127.0.0.1 (밖에서 바로 못 들어오게)
HOST=0.0.0.0

# 데이터(계정, 동기화한 파일)를 둘 폴더. 백업할 때는 이 폴더만 복사하면 돼요.
DATA_DIR=./data

# 처음 운영자 계정. 비밀번호를 비우면 서버가 만들어서 data/INITIAL_ADMIN_PASSWORD.txt 에 적어 둬요.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# 기본은 CI의 OIDC 릴리스 알림 + 디스크 캐시 (GitHub API 폴링 없음).
# GitHub API 주기 조회·비공개 파일 프록시가 필요한 경우에만 토큰 설정 (대체 경로).
GITHUB_TOKEN=

# 선택: 나이스 학교 검색 인증키. 비워도 검색 가능 (키 없으면 최대 5건, 있으면 최대 10건)
NEIS_API_KEY=

# 통합 클라우드 프로그램 자체의 업데이트를 받아 올 저장소
LAUNCHER_REPO=hminkoo10/MagoEdu

# nginx·Caddy 같은 프록시 뒤에서 돌릴 때 1 (접속한 사람 IP를 제대로 기록)
TRUST_PROXY=0

# 파일 하나의 최대 크기(MB)
MAX_FILE_MB=2048
