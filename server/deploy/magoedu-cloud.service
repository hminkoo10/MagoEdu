# 마고에듀 통합 클라우드 서버 (systemd)
#   설치: sudo ./install.sh  (이 파일을 /etc/systemd/system/ 에 넣고 켜 줌)
#   상태: systemctl status magoedu-cloud
#   기록: journalctl -u magoedu-cloud -f
[Unit]
Description=MagoEdu Cloud server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=magoedu
Group=magoedu
WorkingDirectory=/opt/magoedu-cloud
Environment=NODE_ENV=production
Environment=DATA_DIR=/var/lib/magoedu-cloud
EnvironmentFile=-/etc/magoedu-cloud.env
ExecStart=/usr/bin/env node --disable-warning=ExperimentalWarning src/index.js
Restart=always
RestartSec=3
KillSignal=SIGTERM
TimeoutStopSec=20

# 보안: 데이터 폴더 말고는 쓰지 못하게
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/magoedu-cloud
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
