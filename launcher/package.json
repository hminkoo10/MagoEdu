{
  "name": "magoedu-cloud",
  "productName": "MagoEduCloud",
  "version": "1.2.14",
  "description": "마고에듀 통합 클라우드 - 학원 프로그램을 한곳에서 설치·실행·업데이트하고 계정별로 데이터를 동기화",
  "main": "src/main/main.js",
  "author": "구현민",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hminkoo10/MagoEdu.git"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "icons": "node scripts/build-icons.mjs",
    "app-icon": "python scripts/build-app-icon.py",
    "dist": "electron-builder --win --x64 --publish never",
    "test:ui": "xvfb-run -a node test/e2e/ui-e2e.js"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.10",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "lucide-static": "1.56.0",
    "pretendard": "1.3.9"
  },
  "build": {
    "appId": "io.github.hminkoo10.magoedu.cloud",
    "productName": "MagoEduCloud",
    "copyright": "Copyright © 2026 구현민",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "build/icon.png",
      "build/tray.png",
      "package.json",
      "!src/**/*.map"
    ],
    "asar": true,
    "extraFiles": [
      {
        "from": "../LICENSE",
        "to": "LICENSE.txt"
      }
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false
    },
    "protocols": [
      {
        "name": "MagoEdu",
        "schemes": [
          "magoedu"
        ]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "executableName": "MagoEduCloud"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "마고에듀 통합 클라우드",
      "uninstallDisplayName": "마고에듀 통합 클라우드",
      "artifactName": "MagoEduCloud-Setup-${version}.${ext}",
      "installerLanguages": [
        "ko_KR",
        "en_US"
      ],
      "language": "1042",
      "deleteAppDataOnUninstall": false,
      "license": "../LICENSE",
      "include": "build/installer.nsh"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hminkoo10",
        "repo": "MagoEdu",
        "releaseType": "release"
      }
    ]
  }
}
