{
  "name": "magoedu-cloud",
  "productName": "MagoEduCloud",
  "version": "1.0.0",
  "description": "마고에듀 통합 클라우드 - 학원 프로그램을 한곳에서 설치·실행·업데이트하고 계정별로 데이터를 동기화",
  "main": "src/main/main.js",
  "author": "구현민",
  "license": "AGPL-3.0-only",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/hminkoo10/MagoEdu.git"
  },
  "scripts": {
    "postinstall": "node scripts/copy-vendor.mjs",
    "start": "electron .",
    "test": "node --disable-warning=ExperimentalWarning --test --test-concurrency=1 \"test/**/*.test.js\"",
    "icons": "node scripts/build-icons.mjs",
    "app-icon": "node scripts/build-app-icon.mjs",
    "dist": "electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "electron-log": "5.4.4",
    "electron-updater": "6.8.10",
    "yauzl": "3.2.0"
  },
  "devDependencies": {
    "electron": "44.7.2",
    "electron-builder": "26.17.0",
    "lucide-static": "1.56.0",
    "pretendard": "1.3.9"
  }
}
